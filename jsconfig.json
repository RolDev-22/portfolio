{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@utils/*": ["src/utils/*"],
      "@services/*": ["src/services/*"],
      "@features/*": ["src/features/*"],
      "@styles/*": ["src/styles/*"],
      "@layout/*": ["src/components/layout/*"],
      "@assets/*": ["src/assets/*"],
      "@sections/*": ["src/components/sections/*"],
      "@constants/*": ["src/constants/*"],
      "@ui/*": ["src/components/ui/*"]
    }
  }
}
